# systemd user unit for the hub supervisor. Install:
#   mkdir -p ~/.config/systemd/user && cp contrib/t3ih-watch.service ~/.config/systemd/user/
#   edit ExecStart to point at your checkout, then:
#   systemctl --user daemon-reload && systemctl --user enable --now t3ih-watch
#   sudo loginctl enable-linger "$(id -un)"   # keep it running after logout
[Unit]
Description=t3-instabox-helper: tunnels and tailnet routes for InstaBox T3 boxes
After=network-online.target tailscaled.service

[Service]
ExecStart=/usr/bin/env node %h/t3-instabox-helper/bin/t3ih watch
Restart=always
RestartSec=5
# Keys come from ~/.config/t3-instabox-helper/secrets.env (chmod 600), not from here.
MemoryMax=256M

[Install]
WantedBy=default.target
